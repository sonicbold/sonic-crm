# ===================================
# SONIC CRM — Environment Variables
# ===================================
# Copy to .env.local and fill in your values

# Database — Supabase pooler (IPv4). Direct db.*.supabase.co is IPv6-only.
# Transaction pooler (app queries):
DATABASE_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=accept_invalid_certs"
# Session pooler (Prisma migrate / db push):
DIRECT_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=accept_invalid_certs"

# Telnyx (for sending/receiving SMS)
TELNYX_API_KEY=KEY0123456789
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx
# Optional: messaging profile + webhook public key from Mission Control
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

# Finder lead scraper (Google Maps via Apify + review summaries)
APIFY_API_TOKEN=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# OpenAI (for AI auto-reply + sentiment analysis)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Sending window timezone for Strategic Drip (9 AM–7 PM local)
CRM_TIMEZONE=America/New_York

# App URL (for Telnyx webhooks — use a public URL in production / ngrok in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
