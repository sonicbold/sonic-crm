# ===================================
# SONIC CRM — Environment Variables
# ===================================
# Copy to .env.local and fill in your values

# Database — Supabase pooler (IPv4). Direct db.*.supabase.co is IPv6-only.
# Transaction pooler (app queries):
DATABASE_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=accept_invalid_certs"
# Session pooler (Prisma migrate / db push):
DIRECT_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=accept_invalid_certs"

# Telnyx (for sending/receiving SMS)
TELNYX_API_KEY=KEY0123456789
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx
# Optional: messaging profile + webhook public key from Mission Control
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

# Finder lead scraper (Google Maps via Apify + Groq owner names)
APIFY_API_TOKEN=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional Finder AI pool limits (OpenRouter Schematron is treated as uncapped)
FINDER_AI_MIN_DELAY_MS=0
FINDER_GROQ_RPM=30
FINDER_GROQ_RPD=1000
FINDER_GEMINI_RPM=10
FINDER_GEMINI_RPD=250
FINDER_OPENROUTER_RPM=10000
FINDER_OPENROUTER_RPD=1000000
# Maps actor calls per city is a ceiling (3). Complementary queries run only if the city is still thin.
FINDER_MAX_MAP_CALLS=3
# Skip remaining city queries once this many new shops were saved from earlier queries in that city.
FINDER_CITY_SATURATION=40
# Optional quality-check cap. Unset for a full city walk. Example: 10
FINDER_LEAD_CAP=10
# Estimated Apify USD per 1,000 billed dataset rows (override to match your actor pricing).
FINDER_APIFY_MAPS_USD_PER_1K=5
FINDER_APIFY_REVIEWS_USD_PER_1K=4
# OpenRouter list price for inference-net/schematron-v2-turbo.
FINDER_OPENROUTER_USD_PER_1M_PROMPT=0.03
FINDER_OPENROUTER_USD_PER_1M_COMPLETION=0.15

# OpenAI (for AI auto-reply + sentiment analysis)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Sending window timezone for Strategic Drip (9 AM–7 PM local)
CRM_TIMEZONE=America/New_York

# App URL (for Telnyx webhooks — use a public URL in production / ngrok in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature traces in the server log. Leave blank for errors only.
# Examples: *   finder   finder,leads   1
SONIC_DEBUG=
