# ===================================
# PLUMBER CRM — Environment Variables
# ===================================
# Copy to .env.local and fill in your values

# Twilio (for sending/receiving SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Outscraper (for scraping plumber leads from Google Maps)

# OpenAI (for AI auto-reply + sentiment analysis)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Cron protection
CRON_SECRET=make_this_a_long_random_string

# App URL (for Twilio webhook — use ngrok URL in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

